{% extends 'base.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/reset-password.css') }}">
{% endblock %}

{% block body %}
<div class="reset-password-bg">
    <div class="bg-gradient"></div>
    <div class="particle-1"></div>
    <div class="particle-2"></div>
    <div class="particle-3"></div>
    <div class="particle-4"></div>
    <div class="particle-5"></div>
</div>

<div class="d-flex justify-content-center align-items-center min-vh-100 p-3">
    <div class="reset-password-card">
        <div class="reset-password-logo">
            <img src="{{ asset('image/logo.png') }}" alt="2Why Logo">
            <h1>Reset Password</h1>
        </div>

        <div class="text-center mb-4">
            <p class="text-white">
                Please enter your new password.
            </p>
        </div>

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert reset-password-alert" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {{ form_start(resetForm, {'attr': {'class': 'reset-password-form'}}) }}
            <div class="mb-3">
                {{ form_label(resetForm.plainPassword.first, 'New Password', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Enter new password'}}) }}
                {{ form_errors(resetForm.plainPassword.first) }}
            </div>

            <div class="mb-3">
                {{ form_label(resetForm.plainPassword.second, 'Confirm Password', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirm new password'}}) }}
                {{ form_errors(resetForm.plainPassword.second) }}
            </div>

            <div class="d-grid mb-3">
                <button class="btn reset-password-btn" type="submit">
                    Reset password
                </button>
            </div>
        {{ form_end(resetForm) }}

        <div class="text-center">
            <a href="{{ path('app_login') }}" class="reset-password-link">← Back to login</a>
        </div>
    </div>
</div>
{% endblock %}
