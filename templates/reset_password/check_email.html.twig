{% extends 'base.html.twig' %}

{% block title %}Password Reset Email Sent{% endblock %}

{% block stylesheets %}
{{ parent() }}
{% endblock %}

{% block body %}
<div class="reset-password-bg">
    <div class="bg-gradient"></div>
    <div class="particle-1"></div>
    <div class="particle-2"></div>
    <div class="particle-3"></div>
    <div class="particle-4"></div>
    <div class="particle-5"></div>
</div>

<div class="d-flex justify-content-center align-items-center min-vh-100 p-3">
    <div class="reset-password-card">
        <div class="reset-password-logo">
            <img src="{{ asset('image/logo.png') }}" alt="2Why Logo">
            <h1>Check Your Email</h1>
        </div>

        <div class="text-center mb-4">
            <p class="text-white">
                If an account matching your email exists, then an email was just sent that contains a link that you can use to reset your password.
                This link will expire in 1 hour.
            </p>
            <p class="text-white">
                If you don't receive an email please check your spam folder or <a href="{{ path('app_forgot_password_request') }}" class="reset-password-link">try again</a>.
            </p>
        </div>

        <div class="text-center">
            <a href="{{ path('app_login') }}" class="reset-password-link">← Back to login</a>
        </div>
    </div>
</div>
{% endblock %}
