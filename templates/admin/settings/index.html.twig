{% extends 'admin/index.html.twig' %}

{% block title %}Settings{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Website Settings</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="row">
                            <div class="col-md-6">
                                <h4>Logo & Branding</h4>
                                <div class="form-group">
                                    {{ form_label(form.logo) }}
                                    {{ form_widget(form.logo, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_help(form.logo) }}
                                    {{ form_errors(form.logo) }}
                                </div>
                                {% if settings.logo %}
                                    <div class="form-group">
                                        <label>Current Logo:</label><br>
                                        <img src="{{ asset(settings.logo) }}" alt="Current Logo" style="max-width: 200px;">
                                    </div>
                                {% endif %}
                                <div class="form-group">
                                    {{ form_label(form.primaryColor) }}
                                    {{ form_widget(form.primaryColor, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_help(form.primaryColor) }}
                                    {{ form_errors(form.primaryColor) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.secondaryColor) }}
                                    {{ form_widget(form.secondaryColor, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_help(form.secondaryColor) }}
                                    {{ form_errors(form.secondaryColor) }}
                                </div>
                                <div class="form-group">
                                    {{ form_label(form.brandingText) }}
                                    {{ form_widget(form.brandingText, {'attr': {'class': 'form-control', 'rows': 3}}) }}
                                    {{ form_help(form.brandingText) }}
                                    {{ form_errors(form.brandingText) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h4>Payment Configuration</h4>
                                <div class="form-group">
                                    {{ form_label(form.paymentGateway) }}
                                    {{ form_widget(form.paymentGateway, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_help(form.paymentGateway) }}
                                    {{ form_errors(form.paymentGateway) }}
                                </div>
                                <h4>Delivery Configuration</h4>
                                <div class="form-group">
                                    {{ form_label(form.deliveryMethods) }}
                                    {{ form_widget(form.deliveryMethods, {'attr': {'class': 'form-check-input'}}) }}
                                    {{ form_help(form.deliveryMethods) }}
                                    {{ form_errors(form.deliveryMethods) }}
                                </div>
                                <h4>Admin Account Management</h4>
                                <div class="form-group">
                                    {{ form_label(form.adminEmail) }}
                                    {{ form_widget(form.adminEmail, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_help(form.adminEmail) }}
                                    {{ form_errors(form.adminEmail) }}
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary">Save Settings</button>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
