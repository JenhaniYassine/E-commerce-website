{% extends 'base.html.twig' %}

{% block title %}Orders Management - 2Why{% endblock %}

{% block body %}
<!-- Navbar -->
{% include 'partials/navbar.html.twig' %}

<!-- Orders Management -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 mb-4">
                <h1 class="display-4 fw-bold text-primary">Orders Management</h1>
                <p class="lead text-muted">View and manage all orders</p>
            </div>
        </div>

        <!-- Filter Buttons -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="btn-group" role="group">
                    <a href="{{ path('admin_orders') }}" class="btn btn-outline-primary {{ current_status is null ? 'active' : '' }}">All Orders</a>
                    <a href="{{ path('admin_orders', {'status': 'Pending'}) }}" class="btn btn-outline-warning {{ current_status == 'Pending' ? 'active' : '' }}">Pending</a>
                    <a href="{{ path('admin_orders', {'status': 'Confirmed'}) }}" class="btn btn-outline-info {{ current_status == 'Confirmed' ? 'active' : '' }}">Confirmed</a>
                    <a href="{{ path('admin_orders', {'status': 'Shipped'}) }}" class="btn btn-outline-secondary {{ current_status == 'Shipped' ? 'active' : '' }}">Shipped</a>
                    <a href="{{ path('admin_orders', {'status': 'Delivered'}) }}" class="btn btn-outline-success {{ current_status == 'Delivered' ? 'active' : '' }}">Delivered</a>
                    <a href="{{ path('admin_orders', {'status': 'Cancelled'}) }}" class="btn btn-outline-danger {{ current_status == 'Cancelled' ? 'active' : '' }}">Cancelled</a>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="row">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Orders</h5>
                    </div>
                    <div class="card-body">
                        {% if orders is empty %}
                        <p class="text-center text-muted">No orders found.</p>
                        {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th>Status</th>
                                        <th>Total</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for order in orders %}
                                    <tr>
                                        <td>#{{ order.id }}</td>
                                        <td>{{ order.user.email }}</td>
                                        <td>
                                            <span class="badge
                                                {% if order.status == 'Pending' %}bg-warning
                                                {% elseif order.status == 'Confirmed' %}bg-info
                                                {% elseif order.status == 'Shipped' %}bg-secondary
                                                {% elseif order.status == 'Delivered' %}bg-success
                                                {% elseif order.status == 'Cancelled' %}bg-danger
                                                {% endif %}">
                                                {{ order.status }}
                                            </span>
                                        </td>
                                        <td>${{ order.total }}</td>
                                        <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                                        <td>
                                            <a href="{{ path('admin_orders_show', {'id': order.id}) }}" class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
{% include 'partials/footer.html.twig' %}
{% endblock %}
