<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="Shop smart with 2Why - Your one-stop destination for quality products at great prices">
        <meta name="theme-color" content="#2c3e50">
        <title>{% block title %}2Why - Shop Smart, Shop 2Why{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">

        <!-- Skip to main content link for accessibility -->
        <a href="#main-content" class="sr-only sr-only-focusable btn btn-primary position-absolute" style="top: -40px; left: 6px; z-index: 9999;">Skip to main content</a>

        <!-- Initialize Theme Early to Prevent Flash -->
        <script>
            (function() {
                const savedTheme = localStorage.getItem('theme') || 'light';
                document.documentElement.setAttribute('data-theme', savedTheme);
            })();
        </script>

        <!-- Bootstrap 5 CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

        <!-- Google Fonts - Poppins and Inter -->
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

        <!-- Custom CSS - Minimal Inline Styles (Main styles in app.css) -->
        <style>
            /* Prevent FOUC (Flash of Unstyled Content) */
            html {
                scroll-behavior: smooth;
            }

            /* Temporary styles while CSS loads */
            * {
                box-sizing: border-box;
            }

            body {
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', 'Poppins', sans-serif;
                line-height: 1.6;
                overflow-x: hidden;
            }

            /* Accessibility classes */
            .sr-only {
                position: absolute;
                width: 1px;
                height: 1px;
                padding: 0;
                margin: -1px;
                overflow: hidden;
                clip: rect(0, 0, 0, 0);
                white-space: nowrap;
                border: 0;
            }

            .sr-only-focusable:focus {
                position: static;
                width: auto;
                height: auto;
                padding: 0.5rem 1rem;
                margin: 0;
                overflow: visible;
                clip: auto;
                white-space: normal;
                top: 0;
                left: 0;
            }
        </style>

        {% block stylesheets %}{% endblock %}

        <!-- Custom App Styles -->
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <!-- Modern UI Components Library -->
        <link rel="stylesheet" href="{{ asset('styles/components.css') }}">
    </head>
    <body>
        <!-- Skip navigation -->
        <a href="#main-content" class="sr-only sr-only-focusable">Skip to main content</a>

        {% block body %}{% endblock %}

        <!-- Live Chat Widget -->
        {% include 'partials/live_chat.html.twig' %}

        <!-- Bootstrap 5 JS -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

        <!-- Custom App JavaScript -->
        <script src="{{ asset('app.js') }}"></script>

        <!-- Scroll Animation Script -->
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const observerOptions = {
                    threshold: 0.1,
                    rootMargin: '0px 0px -50px 0px'
                };

                const observer = new IntersectionObserver(function(entries) {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('animate');
                        }
                    });
                }, observerOptions);

                // Observe all elements with fade-in-scroll class
                document.querySelectorAll('.fade-in-scroll').forEach(el => {
                    observer.observe(el);
                });
            });
        </script>

        <!-- Load SVG Icon System -->
        <script src="{{ asset('styles/icons.svg') }}"></script>
    </body>
</html>
