{% extends 'base.html.twig' %}

{% block title %}Order Confirmation{% endblock %}

{% block body %}
<!-- Navbar -->
{% include 'partials/navbar.html.twig' %}

<!-- Order Confirmation Section -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Success Message -->
                <div class="text-center mb-5">
                    <div class="success-icon mb-3">
                        <i class="fas fa-check-circle text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="text-success mb-3">Order Confirmed!</h1>
                    <p class="lead text-muted">Thank you for your order. Your order has been successfully placed.</p>
                </div>

                <!-- Progress Bar -->
                <div class="mb-4">
                    <div class="progress">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Complete</div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-success">Address ✓</small>
                        <small class="text-success">Payment ✓</small>
                        <small class="text-success">Confirmation ✓</small>
                    </div>
                </div>

                <div class="row">
                    <!-- Order Details -->
                    <div class="col-lg-8">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Order Details</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Order Number:</strong></div>
                                    <div class="col-sm-8">#{{ order.id }}</div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Order Date:</strong></div>
                                    <div class="col-sm-8">{{ order.createdAt|date('M j, Y g:i A') }}</div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-4"><strong>Status:</strong></div>
                                    <div class="col-sm-8">
                                        <span class="badge bg-primary">{{ order.status }}</span>
                                    </div>
                                </div>
                                <div class="row mb-0">
                                    <div class="col-sm-4"><strong>Total Amount:</strong></div>
                                    <div class="col-sm-8">
                                        <strong class="text-primary h5">${{ order.total|number_format(2) }}</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Order Items -->
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Order Items</h5>
                            </div>
                            <div class="card-body">
                                {% for item in order.getOrderItems() %}
                                    <div class="row mb-3 pb-3 border-bottom">
                                        <div class="col-md-2">
                                            <img src="{{ item.product.image ?: 'https://via.placeholder.com/60x60?text=No+Image' }}"
                                                 alt="{{ item.product.name }}"
                                                 class="img-fluid rounded">
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="mb-1">{{ item.product.name }}</h6>
                                            <p class="text-muted small mb-0">{{ item.product.category.name }}</p>
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <span class="badge bg-secondary">Qty: {{ item.quantity }}</span>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <strong>${{ (item.price * item.quantity)|number_format(2) }}</strong>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <!-- Order Summary & Actions -->
                    <div class="col-lg-4">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">Order Summary</h5>
                            </div>
                            <div class="card-body">
                                {% set subtotal = 0 %}
                                {% for item in order.getOrderItems() %}
                                    {% set subtotal = subtotal + (item.price * item.quantity) %}
                                {% endfor %}
                                {% set shipping = subtotal > 50 ? 0 : 5.99 %}

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal:</span>
                                    <span>${{ subtotal|number_format(2) }}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Shipping:</span>
                                    <span>{% if shipping == 0 %}Free{% else %}${{ shipping|number_format(2) }}{% endif %}</span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between mb-0">
                                    <strong>Total:</strong>
                                    <strong class="text-primary">${{ order.total|number_format(2) }}</strong>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">What's Next?</h5>
                            </div>
                            <div class="card-body">
                                <div class="alert alert-info mb-3">
                                    <i class="fas fa-envelope me-2"></i>
                                    <strong>Order Confirmation Email</strong><br>
                                    <small>You will receive an email confirmation shortly with your order details.</small>
                                </div>

                                <div class="alert alert-warning mb-3">
                                    <i class="fas fa-clock me-2"></i>
                                    <strong>Processing Time</strong><br>
                                    <small>Orders are typically processed within 1-2 business days.</small>
                                </div>

                                <div class="d-grid gap-2">
                                    <a href="{{ path('shop') }}" class="btn btn-primary">
                                        <i class="fas fa-shopping-bag me-2"></i>Continue Shopping
                                    </a>
                                    <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
{% include 'partials/footer.html.twig' %}
{% endblock %}
