{% extends 'base.html.twig' %}

{% block title %}Checkout - Shipping Address{% endblock %}

{% block body %}
<!-- Navbar -->
{% include 'partials/navbar.html.twig' %}

<!-- Checkout Address Section -->
<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="mb-4">Checkout</h1>

                <!-- Progress Bar -->
                <div class="mb-4">
                    <div class="progress">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100">Address</div>
                    </div>
                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-primary">Address</small>
                        <small class="text-muted">Payment</small>
                        <small class="text-muted">Confirmation</small>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Shipping & Billing Address</h5>
                    </div>
                    <div class="card-body">
                        <form action="{{ path('checkout_payment') }}" method="post">
                            <!-- Saved Addresses -->
                            {% if addresses|length > 0 %}
                                <div class="mb-4">
                                    <h6>Use Saved Address</h6>
                                    {% for address in addresses %}
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="radio" name="billing_address" id="billing_{{ address.id }}" value="{{ address.id }}" {% if loop.first %}checked{% endif %}>
                                            <label class="form-check-label" for="billing_{{ address.id }}">
                                                <strong>{{ address.getFullName() }}</strong><br>
                                                {{ address.getFullAddress() }}<br>
                                                {% if address.phone %}{{ address.phone }}<br>{% endif %}
                                                <small class="text-muted">{{ address.type|title }} Address</small>
                                            </label>
                                        </div>
                                    {% endfor %}
                                </div>
                                <hr>
                            {% endif %}

                            <!-- New Address Form -->
                            <h6 class="mb-3">Enter New Address</h6>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="firstName" class="form-label">First Name</label>
                                    <input type="text" class="form-control" id="firstName" name="billing_address_first_name" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="lastName" class="form-label">Last Name</label>
                                    <input type="text" class="form-control" id="lastName" name="billing_address_last_name" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="company" class="form-label">Company (Optional)</label>
                                <input type="text" class="form-control" id="company" name="billing_address_company">
                            </div>
                            <div class="mb-3">
                                <label for="streetAddress" class="form-label">Street Address</label>
                                <input type="text" class="form-control" id="streetAddress" name="billing_address_street_address" required>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="city" class="form-label">City</label>
                                    <input type="text" class="form-control" id="city" name="billing_address_city" required>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="state" class="form-label">State</label>
                                    <input type="text" class="form-control" id="state" name="billing_address_state" required>
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label for="postalCode" class="form-label">Postal Code</label>
                                    <input type="text" class="form-control" id="postalCode" name="billing_address_postal_code" required>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="country" class="form-label">Country</label>
                                    <select class="form-select" id="country" name="billing_address_country" required>
                                        <option value="">Select Country</option>
                                        <option value="US">United States</option>
                                        <option value="CA">Canada</option>
                                        <option value="GB">United Kingdom</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="phone" class="form-label">Phone (Optional)</label>
                                    <input type="tel" class="form-control" id="phone" name="billing_address_phone">
                                </div>
                            </div>

                            <!-- Same as billing checkbox -->
                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" id="sameAsBilling" checked>
                                <label class="form-check-label" for="sameAsBilling">
                                    Shipping address is the same as billing address
                                </label>
                            </div>

                            <!-- Shipping Address (hidden by default) -->
                            <div id="shippingAddressSection" style="display: none;">
                                <h6 class="mb-3">Shipping Address</h6>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="shippingFirstName" class="form-label">First Name</label>
                                        <input type="text" class="form-control" id="shippingFirstName" name="shipping_address_first_name">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="shippingLastName" class="form-label">Last Name</label>
                                        <input type="text" class="form-control" id="shippingLastName" name="shipping_address_last_name">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="shippingCompany" class="form-label">Company (Optional)</label>
                                    <input type="text" class="form-control" id="shippingCompany" name="shipping_address_company">
                                </div>
                                <div class="mb-3">
                                    <label for="shippingStreetAddress" class="form-label">Street Address</label>
                                    <input type="text" class="form-control" id="shippingStreetAddress" name="shipping_address_street_address">
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="shippingCity" class="form-label">City</label>
                                        <input type="text" class="form-control" id="shippingCity" name="shipping_address_city">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label for="shippingState" class="form-label">State</label>
                                        <input type="text" class="form-control" id="shippingState" name="shipping_address_state">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label for="shippingPostalCode" class="form-label">Postal Code</label>
                                        <input type="text" class="form-control" id="shippingPostalCode" name="shipping_address_postal_code">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="shippingCountry" class="form-label">Country</label>
                                        <select class="form-select" id="shippingCountry" name="shipping_address_country">
                                            <option value="">Select Country</option>
                                            <option value="US">United States</option>
                                            <option value="CA">Canada</option>
                                            <option value="GB">United Kingdom</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="shippingPhone" class="form-label">Phone (Optional)</label>
                                        <input type="tel" class="form-control" id="shippingPhone" name="shipping_address_phone">
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between">
                                <a href="{{ path('cart_index') }}" class="btn btn-outline-secondary">Back to Cart</a>
                                <button type="submit" class="btn btn-primary">Continue to Payment</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
{% include 'partials/footer.html.twig' %}

<script>
// Toggle shipping address section
document.getElementById('sameAsBilling').addEventListener('change', function() {
    const shippingSection = document.getElementById('shippingAddressSection');
    if (this.checked) {
        shippingSection.style.display = 'none';
    } else {
        shippingSection.style.display = 'block';
    }
});
</script>
{% endblock %}
