{% extends 'base.html.twig' %}

{% block body %}
<!-- Navbar -->
{% include 'partials/navbar.html.twig' %}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="hero-title">Shop Smart,<br>Shop <span class="text-warning">2Why</span></h1>
                <p class="hero-subtitle">Discover amazing products at unbeatable prices.</p>
                <a href="{{ path('shop') }}" class="btn hero-cta">Shop Now</a>
            </div>
            <div class="col-lg-6">
                <img src="{{ asset('image/logo.png') }}" alt="Shopping" class="img-fluid rounded shadow">
            </div>
        </div>
    </div>
</section>

<!-- Featured Products Carousel -->
<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold text-primary">Featured Products</h2>
                <p class="lead text-muted">Check out our most popular items</p>
            </div>
        </div>

        <div id="featuredCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner">
                {% set chunks = products|batch(4) %}
                {% for chunk in chunks %}
                    <div class="carousel-item {% if loop.first %}active{% endif %}">
                        <div class="row">
                            {% for product in chunk %}
                                {% include 'partials/product_card.html.twig' with {'product': product} only %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#featuredCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#featuredCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <div class="row mt-5">
            <div class="col-12 text-center">
                <a href="{{ path('shop') }}" class="btn btn-primary btn-lg px-5">View All Products</a>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5 fade-in-scroll">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold text-primary">Shop by Category</h2>
                <p class="lead text-muted">Find what you're looking for</p>
            </div>
        </div>
        <div class="row">
            {% for category in categories %}
                <div class="col-lg-3 col-md-6 mb-4">
                    <div class="card category-card h-100 text-center">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <div class="mb-3">
                                <span class="fs-1">{{ category.icon ?: '📦' }}</span>
                            </div>
                            <h5 class="card-title">{{ category.name }}</h5>
                            <p class="card-text text-muted">{{ category.description ?: 'Explore our collection' }}</p>
                            <a href="{{ path('shop') }}?category={{ category.id }}" class="btn btn-outline-primary mt-auto">Shop Now</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

<!-- New Arrivals Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold text-primary">New Arrivals</h2>
                <p class="lead text-muted">Fresh products just added to our store</p>
            </div>
        </div>
        <div class="row">
            {% for product in newArrivals %}
                {% include 'partials/product_card.html.twig' with {'product': product} only %}
            {% endfor %}
        </div>
        <div class="row mt-5">
            <div class="col-12 text-center">
                <a href="{{ path('shop') }}" class="btn btn-primary btn-lg px-5">View All New Arrivals</a>
            </div>
        </div>
    </div>
</section>

<!-- Best Sellers Section -->
<section class="py-5 fade-in-scroll">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5">
                <h2 class="display-5 fw-bold text-primary">Best Sellers</h2>
                <p class="lead text-muted">Most popular products loved by our customers</p>
            </div>
        </div>
        <div class="row">
            {% for product in bestSellers %}
                {% include 'partials/product_card.html.twig' with {'product': product} only %}
            {% endfor %}
        </div>
        <div class="row mt-5">
            <div class="col-12 text-center">
                <a href="{{ path('shop') }}" class="btn btn-primary btn-lg px-5">View All Best Sellers</a>
            </div>
        </div>
    </div>
</section>

<!-- Promotional Banners -->
<section class="py-5 bg-warning">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="card border-0 bg-transparent">
                    <div class="card-body text-center">
                        <h3 class="card-title text-dark">Free Shipping</h3>
                        <p class="card-text text-dark">On orders over $50</p>
                        <span class="fs-1">🚚</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-4">
                <div class="card border-0 bg-transparent">
                    <div class="card-body text-center">
                        <h3 class="card-title text-dark">Flash Sale</h3>
                        <p class="card-text text-dark">Up to 50% off selected items</p>
                        <span class="fs-1">⚡</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 text-center mb-4">
                <div class="mb-3">
                    <span class="fs-1">🚚</span>
                </div>
                <h4>Free Shipping</h4>
                <p class="text-muted">Free shipping on orders over $50</p>
            </div>
            <div class="col-lg-4 text-center mb-4">
                <div class="mb-3">
                    <span class="fs-1">🔒</span>
                </div>
                <h4>Secure Payment</h4>
                <p class="text-muted">100% secure payment processing</p>
            </div>
            <div class="col-lg-4 text-center mb-4">
                <div class="mb-3">
                    <span class="fs-1">↩️</span>
                </div>
                <h4>Easy Returns</h4>
                <p class="text-muted">30-day return policy</p>
            </div>
        </div>
    </div>
</section>

<!-- Footer -->
{% include 'partials/footer.html.twig' %}
{% endblock %}
