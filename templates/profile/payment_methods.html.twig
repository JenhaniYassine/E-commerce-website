{% extends 'base.html.twig' %}

{% block title %}Payment Methods - {{ parent() }}{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <!-- Profile Sidebar -->
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            {{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}
                        </div>
                    </div>
                    <h5 class="card-title">{{ app.user.firstName }} {{ app.user.lastName }}</h5>
                    <p class="text-muted">{{ app.user.email }}</p>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('profile_index') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-user me-2"></i>Profile Overview
                    </a>
                    <a href="{{ path('profile_orders') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-shopping-bag me-2"></i>My Orders
                    </a>
                    <a href="{{ path('profile_addresses') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-map-marker-alt me-2"></i>Addresses
                    </a>
                    <a href="{{ path('profile_payment_methods') }}" class="list-group-item list-group-item-action active">
                        <i class="fas fa-credit-card me-2"></i>Payment Methods
                    </a>
                    <a href="{{ path('profile_wishlist') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-heart me-2"></i>Wishlist
                    </a>
                    <a href="{{ path('profile_settings') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-cog me-2"></i>Settings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <!-- Payment Methods List -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Payment Methods</h4>
                    <a href="{{ path('profile_payment_methods_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Payment Method
                    </a>
                </div>
                <div class="card-body">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {% if paymentMethods is empty %}
                        <div class="text-center py-5">
                            <i class="fas fa-credit-card text-muted" style="font-size: 4rem;"></i>
                            <h5 class="mt-3 text-muted">No payment methods saved</h5>
                            <p class="text-muted">Add a payment method to make checkout faster.</p>
                            <a href="{{ path('profile_payment_methods_new') }}" class="btn btn-primary">Add Payment Method</a>
                        </div>
                    {% else %}
                        <div class="row">
                            {% for paymentMethod in paymentMethods %}
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="card-title mb-1">{{ paymentMethod.cardType|title }} ****{{ paymentMethod.lastFourDigits }}</h6>
                                                    <small class="text-muted">{{ paymentMethod.cardholderName }}</small>
                                                </div>
                                                {% if paymentMethod.isDefault %}
                                                    <span class="badge bg-primary">Default</span>
                                                {% endif %}
                                            </div>
                                            <p class="text-muted mb-3">
                                                Expires {{ paymentMethod.expiryMonth }}/{{ paymentMethod.expiryYear }}
                                            </p>
                                            <div class="d-flex gap-2">
                                                <a href="{{ path('profile_payment_methods_edit', {'id': paymentMethod.id}) }}" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-edit me-1"></i>Edit
                                                </a>
                                                <form method="post" action="{{ path('profile_payment_methods_delete', {'id': paymentMethod.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this payment method?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ paymentMethod.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="fas fa-trash me-1"></i>Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
