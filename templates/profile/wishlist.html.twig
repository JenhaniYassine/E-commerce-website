{% extends 'base.html.twig' %}

{% block title %}My Wishlist - {{ parent() }}{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <!-- Profile Sidebar -->
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            {{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}
                        </div>
                    </div>
                    <h5 class="card-title">{{ app.user.firstName }} {{ app.user.lastName }}</h5>
                    <p class="text-muted">{{ app.user.email }}</p>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('profile_index') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-user me-2"></i>Profile Overview
                    </a>
                    <a href="{{ path('profile_orders') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-shopping-bag me-2"></i>My Orders
                    </a>
                    <a href="{{ path('profile_addresses') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-map-marker-alt me-2"></i>Addresses
                    </a>
                    <a href="{{ path('profile_payment_methods') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-credit-card me-2"></i>Payment Methods
                    </a>
                    <a href="{{ path('profile_wishlist') }}" class="list-group-item list-group-item-action active">
                        <i class="fas fa-heart me-2 heart-pulse"></i>Wishlist
                    </a>
                    <a href="{{ path('profile_settings') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-cog me-2"></i>Settings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <!-- Wishlist -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">My Wishlist</h4>
                </div>
                <div class="card-body">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {% if wishlists is empty %}
                        <div class="text-center py-5">
                            <div class="mb-4" role="img" aria-label="Empty wishlist illustration">
                                <svg width="200" height="150" class="text-muted" aria-hidden="true">
                                    <use href="#icon-empty-heart"></use>
                                </svg>
                            </div>
                            <h5 class="text-primary fw-bold">Your wishlist is empty</h5>
                            <p class="text-muted">Discover and save your favorite products from 2Why for later.</p>
                            <a href="{{ path('shop') }}" class="btn btn-primary">Explore Products</a>
                        </div>
                    {% else %}
                        <div class="row">
                            {% for wishlist in wishlists %}
                                <div class="col-md-4 mb-4">
                                    <div class="card h-100">
                                        <div class="position-relative">
                                            {% if wishlist.product.images|length > 0 %}
                                                <img src="{{ asset('uploads/products/' ~ wishlist.product.images[0].filename) }}" class="card-img-top" alt="{{ wishlist.product.name }}" style="height: 200px; object-fit: cover;">
                                            {% else %}
                                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                    <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
                                                </div>
                                            {% endif %}
                                            <button class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" onclick="removeFromWishlist({{ wishlist.id }})">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                        <div class="card-body d-flex flex-column">
                                            <h6 class="card-title">{{ wishlist.product.name }}</h6>
                                            <p class="card-text text-muted small">{{ wishlist.product.description|slice(0, 100) ~ '...' }}</p>
                                            <div class="mt-auto">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="h5 text-primary mb-0">${{ wishlist.product.price|number_format(2) }}</span>
                                                    <a href="{{ path('product_detail', {'id': wishlist.product.id}) }}" class="btn btn-primary btn-sm">
                                                        View Product
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function removeFromWishlist(wishlistId) {
    if (confirm('Are you sure you want to remove this item from your wishlist?')) {
        fetch('{{ path('profile_wishlist_remove', {'id': 'WID'}) }}'.replace('WID', wishlistId), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
        }).then(response => {
            if (response.ok) {
                location.reload();
            }
        });
    }
}
</script>
{% endblock %}
