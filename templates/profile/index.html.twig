{% extends 'base.html.twig' %}

{% block title %}My Profile - {{ parent() }}{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <!-- Profile Sidebar -->
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            {{ user.firstName|first|upper ~ user.lastName|first|upper }}
                        </div>
                    </div>
                    <h5 class="card-title">{{ user.firstName }} {{ user.lastName }}</h5>
                    <p class="text-muted">{{ user.email }}</p>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('profile_index') }}" class="list-group-item list-group-item-action active">
                        <i class="fas fa-user me-2"></i>Profile Overview
                    </a>
                    <a href="{{ path('profile_orders') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-shopping-bag me-2"></i>My Orders
                    </a>
                    <a href="{{ path('profile_addresses') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-map-marker-alt me-2"></i>Addresses
                    </a>
                    <a href="{{ path('profile_payment_methods') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-credit-card me-2"></i>Payment Methods
                    </a>
                    <a href="{{ path('profile_wishlist') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-heart me-2"></i>Wishlist
                    </a>
                    <a href="{{ path('profile_settings') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-cog me-2"></i>Settings
                    </a>
                    <a href="{{ path('order_issue') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-exclamation-triangle me-2"></i>Report Issue
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <!-- Profile Overview -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">Profile Overview</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Personal Information</h6>
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted">First Name:</td>
                                    <td>{{ user.firstName ?: 'Not set' }}</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Last Name:</td>
                                    <td>{{ user.lastName ?: 'Not set' }}</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Email:</td>
                                    <td>{{ user.email }}</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Phone:</td>
                                    <td>{{ user.phone ?: 'Not set' }}</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Member Since:</td>
                                    <td>{{ user.createdAt|date('M j, Y') }}</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6>Account Summary</h6>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded p-3 me-3">
                                    <i class="fas fa-shopping-bag text-primary" style="font-size: 2rem;"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">{{ user.orders|length }}</h5>
                                    <small class="text-muted">Total Orders</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-light rounded p-3 me-3">
                                    <i class="fas fa-map-marker-alt text-success" style="font-size: 2rem;"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">{{ user.addresses|length }}</h5>
                                    <small class="text-muted">Saved Addresses</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-3 me-3">
                                    <i class="fas fa-heart text-danger" style="font-size: 2rem;"></i>
                                </div>
                                <div>
                                    <h5 class="mb-0">{{ user.wishlists|length }}</h5>
                                    <small class="text-muted">Wishlist Items</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
