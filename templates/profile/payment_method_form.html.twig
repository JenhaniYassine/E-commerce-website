{% extends 'base.html.twig' %}

{% block title %}{% if paymentMethod.id %}Edit{% else %}Add{% endif %} Payment Method - {{ parent() }}{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">{% if paymentMethod.id %}Edit{% else %}Add New{% endif %} Payment Method</h4>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.cardType) }}
                            {{ form_widget(form.cardType, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.cardType) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.cardholderName) }}
                            {{ form_widget(form.cardholderName, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.cardholderName) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.lastFourDigits) }}
                            {{ form_widget(form.lastFourDigits, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.lastFourDigits) }}
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.expiryMonth) }}
                                {{ form_widget(form.expiryMonth, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.expiryMonth) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.expiryYear) }}
                                {{ form_widget(form.expiryYear, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.expiryYear) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_widget(form.isDefault, {'attr': {'class': 'form-check-input'}}) }}
                            {{ form_label(form.isDefault, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            {{ form_errors(form.isDefault) }}
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>{% if paymentMethod.id %}Update{% else %}Add{% endif %} Payment Method
                            </button>
                            <a href="{{ path('profile_payment_methods') }}" class="btn btn-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
