{% extends 'base.html.twig' %}

{% block title %}My Orders - {{ parent() }}{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <!-- Profile Sidebar -->
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            {{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}
                        </div>
                    </div>
                    <h5 class="card-title">{{ app.user.firstName }} {{ app.user.lastName }}</h5>
                    <p class="text-muted">{{ app.user.email }}</p>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('profile_index') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-user me-2"></i>Profile Overview
                    </a>
                    <a href="{{ path('profile_orders') }}" class="list-group-item list-group-item-action active">
                        <i class="fas fa-shopping-bag me-2"></i>My Orders
                    </a>
                    <a href="{{ path('profile_addresses') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-map-marker-alt me-2"></i>Addresses
                    </a>
                    <a href="{{ path('profile_payment_methods') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-credit-card me-2"></i>Payment Methods
                    </a>
                    <a href="{{ path('profile_wishlist') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-heart me-2"></i>Wishlist
                    </a>
                    <a href="{{ path('profile_settings') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-cog me-2"></i>Settings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <!-- Orders List -->
            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">My Orders</h4>
                </div>
                <div class="card-body">
                    {% if orders is empty %}
                        <div class="text-center py-5">
                            <div class="mb-4" role="img" aria-label="Empty orders illustration">
                                <svg width="200" height="150" class="text-muted" aria-hidden="true">
                                    <use href="#icon-empty-orders"></use>
                                </svg>
                            </div>
                            <h5 class="text-primary fw-bold">No orders yet</h5>
                            <p class="text-muted">Your order history will appear here once you make your first purchase at 2Why.</p>
                            <a href="{{ path('shop') }}" class="btn btn-primary">Shop Now</a>
                        </div>
                    {% else %}
                        <div class="row">
                            {% for order in orders %}
                                <div class="col-12 mb-3">
                                    <div class="card border">
                                        <div class="card-body">
                                            <div class="row align-items-center">
                                                <div class="col-md-2">
                                                    <span class="badge bg-primary fs-6">Order #{{ order.id }}</span>
                                                </div>
                                                <div class="col-md-3">
                                                    <small class="text-muted">Date</small>
                                                    <br>
                                                    <strong>{{ order.createdAt|date('M j, Y') }}</strong>
                                                </div>
                                                <div class="col-md-2">
                                                    <small class="text-muted">Status</small>
                                                    <br>
                                                    <span class="badge bg-success">{{ order.status }}</span>
                                                </div>
                                                <div class="col-md-2">
                                                    <small class="text-muted">Total</small>
                                                    <br>
                                                    <strong>${{ order.total|number_format(2) }}</strong>
                                                </div>
                                                <div class="col-md-3 text-end">
                                                    <a href="#" class="btn btn-outline-primary btn-sm">View Details</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
