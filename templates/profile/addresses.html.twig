{% extends 'base.html.twig' %}

{% block title %}My Addresses - {{ parent() }}{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-3">
            <!-- Profile Sidebar -->
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            {{ app.user.firstName|first|upper ~ app.user.lastName|first|upper }}
                        </div>
                    </div>
                    <h5 class="card-title">{{ app.user.firstName }} {{ app.user.lastName }}</h5>
                    <p class="text-muted">{{ app.user.email }}</p>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('profile_index') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-user me-2"></i>Profile Overview
                    </a>
                    <a href="{{ path('profile_orders') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-shopping-bag me-2"></i>My Orders
                    </a>
                    <a href="{{ path('profile_addresses') }}" class="list-group-item list-group-item-action active">
                        <i class="fas fa-map-marker-alt me-2"></i>Addresses
                    </a>
                    <a href="{{ path('profile_payment_methods') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-credit-card me-2"></i>Payment Methods
                    </a>
                    <a href="{{ path('profile_wishlist') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-heart me-2"></i>Wishlist
                    </a>
                    <a href="{{ path('profile_settings') }}" class="list-group-item list-group-item-action">
                        <i class="fas fa-cog me-2"></i>Settings
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <!-- Addresses List -->
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">My Addresses</h4>
                    <a href="{{ path('profile_addresses_new') }}" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add New Address
                    </a>
                </div>
                <div class="card-body">
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {% if addresses is empty %}
                        <div class="text-center py-5">
                            <div class="mb-4" role="img" aria-label="Empty addresses illustration">
                                <svg width="200" height="150" class="text-muted" aria-hidden="true">
                                    <use href="#icon-empty-address"></use>
                                </svg>
                            </div>
                            <h5 class="text-primary fw-bold">No addresses yet</h5>
                            <p class="text-muted">Add your shipping address to streamline your 2Why shopping experience.</p>
                            <a href="{{ path('profile_addresses_new') }}" class="btn btn-primary">Add Your Address</a>
                        </div>
                    {% else %}
                        <div class="row">
                            {% for address in addresses %}
                                <div class="col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="card-title mb-0">{{ address.type|title }}</h6>
                                                {% if address.isDefault %}
                                                    <span class="badge bg-primary">Default</span>
                                                {% endif %}
                                            </div>
                                            <address class="mb-3">
                                                {{ address.firstName }} {{ address.lastName }}<br>
                                                {{ address.streetAddress }}<br>
                                                {% if address.apartment %}Apt {{ address.apartment }}<br>{% endif %}
                                                {{ address.city }}, {{ address.state }} {{ address.postalCode }}<br>
                                                {{ address.country }}
                                            </address>
                                            <div class="d-flex gap-2">
                                                <a href="{{ path('profile_addresses_edit', {'id': address.id}) }}" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-edit me-1"></i>Edit
                                                </a>
                                                <form method="post" action="{{ path('profile_addresses_delete', {'id': address.id}) }}" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this address?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ address.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                        <i class="fas fa-trash me-1"></i>Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
