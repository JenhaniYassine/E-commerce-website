{% extends 'base.html.twig' %}

{% block title %}Shopping Cart{% endblock %}

{% block body %}
<!-- Navbar -->
{% include 'partials/navbar.html.twig' %}

<!-- Main Content -->
<main id="main-content" class="fade-in">
    <!-- Cart Section -->
    <section class="py-5" aria-labelledby="cart-heading">
        <div class="container">
            <h1 id="cart-heading" class="mb-4">Shopping Cart</h1>

            {% if cartItems is empty %}
                <div class="text-center py-5">
                    <div class="mb-4" role="img" aria-label="Empty shopping cart illustration">
                        <svg width="200" height="150" class="text-muted mb-3" aria-hidden="true">
                            <use href="#icon-empty-cart"></use>
                        </svg>
                    </div>
                    <h3 class="text-primary fw-bold">Your cart is feeling lonely</h3>
                    <p class="text-muted mb-4">Discover amazing products and fill it up with your favorites at 2Why!</p>
                    <a href="{{ path('shop') }}" class="btn btn-primary btn-lg">
                        <svg width="20" height="20" class="me-2" aria-hidden="true">
                            <use href="#icon-2why-logo"></use>
                        </svg>Start Shopping at 2Why
                    </a>
                </div>
            {% else %}
                <div class="row">
                    <!-- Cart Items -->
                    <div class="col-lg-8">
                        <div class="card shadow-sm">
                            <div class="card-header bg-light">
                                <h2 class="h5 mb-0" id="cart-items-heading">Cart Items ({{ cartItems|length }})</h2>
                            </div>
                            <div class="card-body">
                                {% for item in cartItems %}
                                    <article class="row mb-4 pb-4 border-bottom cart-item" data-product-id="{{ item.product.id }}" role="article" aria-labelledby="item-title-{{ item.product.id }}">
                                        <div class="col-md-3">
                                            <img src="{{ item.product.image ?: 'https://via.placeholder.com/150x150?text=No+Image' }}"
                                                 alt="Product image for {{ item.product.name }}"
                                                 class="img-fluid rounded shadow-sm"
                                                 loading="lazy">
                                        </div>
                                        <div class="col-md-6">
                                            <h3 class="h5 mb-1" id="item-title-{{ item.product.id }}">{{ item.product.name }}</h3>
                                            <p class="text-muted mb-2" aria-label="Category">{{ item.product.category.name }}</p>
                                            <p class="mb-3 fw-bold text-primary" aria-label="Unit price">${{ item.product.price }}</p>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="quantity-controls" role="group" aria-label="Quantity controls for {{ item.product.name }}">
                                                    <label for="quantity-{{ item.product.id }}" class="visually-hidden">Quantity for {{ item.product.name }}</label>
                                                    <div class="input-group" style="width: 140px;">
                                                        <button class="btn btn-outline-secondary btn-sm quantity-btn"
                                                                type="button"
                                                                onclick="changeQuantity({{ item.product.id }}, -1)"
                                                                aria-label="Decrease quantity">-</button>
                                                        <input type="number"
                                                               class="form-control form-control-sm text-center quantity-input"
                                                               id="quantity-{{ item.product.id }}"
                                                               name="quantity"
                                                               value="{{ item.quantity }}"
                                                               min="1"
                                                               max="{{ item.product.stockQuantity }}"
                                                               onchange="updateQuantity({{ item.product.id }}, this.value)"
                                                               aria-describedby="quantity-help-{{ item.product.id }}">
                                                        <button class="btn btn-outline-secondary btn-sm quantity-btn"
                                                                type="button"
                                                                onclick="changeQuantity({{ item.product.id }}, 1)"
                                                                aria-label="Increase quantity">+</button>
                                                    </div>
                                                    <div id="quantity-help-{{ item.product.id }}" class="visually-hidden">
                                                        Enter quantity between 1 and {{ item.product.stockQuantity }}
                                                    </div>
                                                </div>
                                                <a href="{{ path('cart_remove', {'id': item.product.id}) }}"
                                                   class="text-danger text-decoration-none remove-link"
                                                   onclick="return confirmRemove('{{ item.product.name }}')"
                                                   aria-label="Remove {{ item.product.name }} from cart">
                                                    <i class="fas fa-trash me-1" aria-hidden="true"></i>
                                                    <span class="d-none d-md-inline">Remove</span>
                                                </a>
                                            </div>
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <p class="h5 text-primary fw-bold mb-0" aria-label="Total price for this item">${{ item.total|number_format(2) }}</p>
                                        </div>
                                    </article>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <!-- Order Summary -->
                    <div class="col-lg-4">
                        <div class="card shadow-sm sticky-top" style="top: 20px;">
                            <div class="card-header bg-light">
                                <h2 class="h5 mb-0" id="order-summary-heading">Order Summary</h2>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal:</span>
                                    <span aria-label="Subtotal amount">${{ subtotal|number_format(2) }}</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Shipping:</span>
                                    <span aria-label="Shipping cost">
                                        {% if shipping == 0 %}
                                            Free
                                        {% else %}
                                            ${{ shipping|number_format(2) }}
                                        {% endif %}
                                    </span>
                                </div>
                                <hr aria-hidden="true">
                                <div class="d-flex justify-content-between mb-3">
                                    <strong>Total:</strong>
                                    <strong class="text-primary h5 mb-0" aria-label="Total order amount">${{ total|number_format(2) }}</strong>
                                </div>
                                <a href="{{ path('checkout_address') }}"
                                   class="btn btn-primary w-100 mb-2 btn-lg"
                                   aria-describedby="checkout-description">
                                    <i class="fas fa-credit-card me-2" aria-hidden="true"></i>
                                    Proceed to Checkout
                                </a>
                                <div id="checkout-description" class="visually-hidden">
                                    Proceed to checkout with {{ cartItems|length }} item{{ cartItems|length > 1 ? 's' : '' }} totaling ${{ total|number_format(2) }}
                                </div>
                                <a href="{{ path('shop') }}" class="btn btn-outline-primary w-100">
                                    <i class="fas fa-arrow-left me-2" aria-hidden="true"></i>
                                    Continue Shopping
                                </a>
                            </div>
                        </div>

                        <!-- Shipping Info -->
                        <div class="card mt-3 shadow-sm">
                            <div class="card-body">
                                <h3 class="h6 mb-2" id="shipping-info-heading">Shipping Information</h3>
                                <p class="small text-muted mb-0" aria-labelledby="shipping-info-heading">
                                    Free shipping on orders over $50. Standard shipping: $5.99
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
</main>

<!-- Footer -->
{% include 'partials/footer.html.twig' %}

<script>
// Quantity change functions with animations
function changeQuantity(productId, delta) {
    const input = document.getElementById(`quantity-${productId}`);
    const currentValue = parseInt(input.value);
    const newValue = currentValue + delta;
    const maxStock = parseInt(input.getAttribute('max'));

    if (newValue >= 1 && newValue <= maxStock) {
        // Add animation class
        const cartItem = input.closest('.cart-item');
        cartItem.classList.add('fade-in');

        input.value = newValue;
        updateQuantity(productId, newValue);

        // Remove animation class after animation
        setTimeout(() => {
            cartItem.classList.remove('fade-in');
        }, 300);
    }
}

function updateQuantity(productId, quantity) {
    // Show loading state
    const cartItem = document.querySelector(`[data-product-id="${productId}"]`);
    cartItem.classList.add('loading');

    // Auto-submit the form
    const form = document.querySelector(`form[action*="${productId}"]`);
    if (form) {
        form.submit();
    }
}

function confirmRemove(productName) {
    return confirm(`Are you sure you want to remove "${productName}" from your cart?`);
}

// Add loading animation to quantity buttons
document.addEventListener('DOMContentLoaded', function() {
    const quantityBtns = document.querySelectorAll('.quantity-btn');
    quantityBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            this.style.transform = 'scale(0.95)';
            setTimeout(() => {
                this.style.transform = 'scale(1)';
            }, 100);
        });
    });

    // Add slide-in animation to cart items
    const cartItems = document.querySelectorAll('.cart-item');
    cartItems.forEach((item, index) => {
        item.style.animationDelay = `${index * 0.1}s`;
        item.classList.add('slide-in');
    });
});
</script>
{% endblock %}
